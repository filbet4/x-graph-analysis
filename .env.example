# Example local configuration. Do not place secrets in source control.
X_GRAPH_ANALYSIS_LOG_LEVEL=INFO
X_GRAPH_ANALYSIS_ENVIRONMENT=development

# TODO: Add X API configuration only when the approved integration is designed.
# Neo4j
X_GRAPH_ANALYSIS_NEO4J_URI=neo4j://127.0.0.1:7687
X_GRAPH_ANALYSIS_NEO4J_USER=neo4j
